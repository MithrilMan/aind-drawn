{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aind-drawn/reference.schema.json",
  "title": "External source reference",
  "type": "object",
  "required": [
    "name",
    "repository",
    "checkoutDirectory",
    "referenceRef",
    "referenceCommit",
    "referenceDate",
    "reviewedAreas"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "format": "uri" },
    "checkoutDirectory": { "type": "string", "minLength": 1 },
    "referenceRef": { "type": "string", "pattern": "^refs/heads/[A-Za-z0-9._/-]+$" },
    "referenceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "referenceDate": { "type": "string", "format": "date-time" },
    "reviewedAreas": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
